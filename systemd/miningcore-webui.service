[Unit]
Description=Miningcore WebUI and API Reverse Proxy
After=network.target miningcore.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pool/webui
Environment=UI_PORT=8080
Environment=API_HOST=127.0.0.1
Environment=API_PORT=4000
ExecStart=/usr/bin/env node server.js
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=miningcore-webui

[Install]
WantedBy=multi-user.target
