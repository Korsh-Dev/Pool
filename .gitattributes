* text=auto

# Linux Scripts and Configuration (Enforce LF)
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries
*.dll binary
*.so binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
